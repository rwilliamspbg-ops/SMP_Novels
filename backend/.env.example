# Cognoscent Echo - Production Environment Configuration
# Copy this file to .env and fill in your values for production deployment

# ==================== Application ====================
NODE_ENV=production
APP_NAME=cognoscent-echo-backend

# ==================== Database (PostgreSQL) ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=interactive_novel
DB_USER=postgres
DB_PASSWORD=your_secure_database_password_here  # Change this! Use: openssl rand -hex 32

# ==================== Authentication & Security ====================
# Generate secure JWT secret: openssl rand -hex 32
JWT_SECRET=$(openssl rand -hex 32)

API_KEY=${API_KEY:-your_api_key_for_authentication}  # Set your API key

# ==================== Rate Limiting ====================
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1m

# ==================== CORS ====================
# In production, set to specific origin: https://echo-platform.vercel.app
ALLOWED_CORS_URLS=http://localhost:3000

# ==================== Backend API ====================
FRONTEND_URL=http://localhost:3000
BACKEND_PORT=3001

# ==================== Logging ====================
LOG_LEVEL=info
ENABLE_JSON_LOGGING=true

# ==================== Monitoring & Observability ====================
ENABLE_METRICS=false
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30s

# ==================== Feature Flags ====================
ENABLE_WASM_SANDBOX=true
ENABLE_AI_RESPONSES=true
ENABLE_GOVERNANCE_VOTING=true
ENABLE_ANALYTICS=false

# ==================== Security Headers ====================
SECURE_COOKIES=true
ADMIN_ROLE_REQUIRED=false  # Enable admin-only routes when true
