# ============ Authentication & Security ============
JWT_SECRET=<CHANGE_ME_Generate_64_hex_chars_with_this_command:>
  # Run: openssl rand -hex 32
API_KEY=<CHANGE_ME_Your_API_key_for_authentication>

# ============ Database Connections ============
MONGODB_URI=mongodb://mongodb:27017/interactive_novel?authSource=admin

# ============ Cache & Messaging ============
REDIS_URL=redis://redis:6379

# ============ Application Settings ============
NODE_ENV=development  # Change to 'production' for prod
PORT=3001
FRONTEND_URL=http://localhost:3000

# ============ Feature Flags ============
ENABLE_WASM_SANDBOX=true
ENABLE_AI_RESPONSES=true
ENABLE_GOVERNANCE_VOTING=true
ENABLE_ANALYTICS=false

# ============ Rate Limiting ============
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============ Logging ============
LOG_LEVEL=debug
LOG_FORMAT=json

# ============ Monitoring & Observability ============
PROMETHEUS_ENABLED=false
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30000

# ============ Security Headers ============
CORS_ORIGIN=*  # Set to specific origin in production (e.g., https://yourdomain.com)
SECURE_COOKIES=true
ADMIN_ROLE_REQUIRED=true  # Enable admin-only routes when true

# ============ Governance Defaults ============
BFT_THRESHOLD_PCT=55.5
DEFAULT_BLOCK_SIZE_BYTES=2000
