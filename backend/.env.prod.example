# ============ Production Environment Configuration ============
# IMPORTANT: Copy this to .env with REAL values before deployment!

# ============ Authentication & Security (REQUIRED) ============
JWT_SECRET=<GENERATE_THIS_WITH_COMMAND_BELOW>
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
CORS_ORIGIN=https://your-production-domain.com  # Set specific domain, NOT *
SECURE_COOKIES=true

# ============ Database Connections ============
MONGODB_URI=mongodb://<mongodb-host>:27017/interactive_novel?authSource=admin
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.com/dbname

# ============ Cache & Messaging ============
REDIS_URL=redis://redis:6379  # Or update with production Redis URL

# ============ Application Settings ============
NODE_ENV=production            # Must be 'production' for security hardening
PORT=3001                      # Or use load balancer port
FRONTEND_URL=https://your-frontend.com

# ============ Feature Flags ============
ENABLE_WASM_SANDBOX=true
ENABLE_AI_RESPONSES=true      # Set false in production if using cached responses
ENABLE_GOVERNANCE_VOTING=true
ENABLE_ANALYTICS=false         # Enable for production monitoring

# ============ Rate Limiting ============
RATE_LIMIT_WINDOW_MS=60000     # 1 minute window
RATE_LIMIT_MAX_REQUESTS=100    # Per user per window

# ============ Logging ============
LOG_LEVEL=info                 # Reduce verbosity for production
LOG_FORMAT=json                # Structured logging for monitoring

# ============ Monitoring & Observability ============
PROMETHEUS_ENABLED=false       # Enable for production metrics (set true)
METRICS_PORT=9090              # Prometheus scrape port
HEALTH_CHECK_INTERVAL=30000    # 30 seconds between health checks

# ============ Security Headers ============
ADMIN_ROLE_REQUIRED=true       # Enable strict admin access control

# ============ Governance Defaults ============
BFT_THRESHOLD_PCT=55.5
DEFAULT_BLOCK_SIZE_BYTES=2000
