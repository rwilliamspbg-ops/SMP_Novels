{
  "name": "cognoscent-echo-backend",
  "version": "1.0.0-production",
  "description": "Cognoscent Echo Interactive Platform - Backend API with PostgreSQL",
  "main": "src/server_fastify.js",
  "scripts": {
    "start": "node src/server_fastify.js",
    "dev": "nodemon src/server_fastify.js",
    "test": "jest --coverage",
    "lint": "eslint src/",
    "audit-narrative": "node src/audit_narrative.js",
    "health-check": "node -e \"const f=require('./src/database'); f.initializeSchema().then(()=>console.log('DB OK')).catch(e=>console.error(e))\"",
    "init-db": "node -e \"const db=require('./src/database'); db.initializeSchema().then(()=>console.log('Schema initialized')).catch(e=>{console.error(e); process.exit(1)})\"",
    "reset-user": "node -e \\\"const {getReaderProgress} = require('./src/database'); const uid=process.argv[2]||'test-user'; getReaderProgress(uid).then(p=>console.log(JSON.stringify(p,null,2))).catch(e=>console.error(e))\\\"",
    "migrate": "node ./scripts/migrate.js"
  },
  "dependencies": {
    "fastify": "^4.26.2",
    "@fastify/cors": "^8.5.0",
    "@fastify/rate-limit": "^9.1.0",
    "helmet": "^7.1.0",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1",
    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "interactive-novel",
    "saga-pattern",
    "fastify",
    "postgresql"
  ],
  "author": "Cognoscent Echo Team",
  "license": "MIT"
}
