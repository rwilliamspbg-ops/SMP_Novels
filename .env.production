# Cognoscent Echo - Production Environment Configuration
# Use docker-compose.yml with environment variables set externally

# ==================== Application ====================
NODE_ENV=production
APP_NAME=cognoscent-echo

# ==================== Database (PostgreSQL) ====================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=interactive_novel
DB_USER=postgres
DB_PASSWORD=your_secure_database_password_here  # MUST SET THIS IN PRODUCTION!

# ==================== Authentication & Security ====================
# Generate secure JWT secret: openssl rand -hex 32
JWT_SECRET=$(openssl rand -hex 32)

API_KEY=${API_KEY:-production_api_key_required}  # Set your API key

# ==================== Rate Limiting ====================
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1m

# ==================== CORS ====================
# In production, set to specific origin: https://echo-platform.vercel.app
ALLOWED_CORS_URLS=https://echo-platform.vercel.app

# ==================== Backend API ====================
FRONTEND_URL=https://echo-platform.vercel.app
BACKEND_PORT=3001

# ==================== Logging ====================
LOG_LEVEL=info
ENABLE_JSON_LOGGING=true

# ==================== Monitoring & Observability ====================
ENABLE_METRICS=true
METRICS_PORT=9090

# ==================== Feature Flags ====================
ENABLE_WASM_SANDBOX=false  # Disable in production unless needed
ENABLE_AI_RESPONSES=true
ENABLE_GOVERNANCE_VOTING=true
ENABLE_ANALYTICS=true
