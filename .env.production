# Cognoscent Echo - Production Environment Configuration (v3.3.1)
# Copy this file to .env.production and use in Docker or deployment
# IMPORTANT: Replace all placeholder values with actual secure credentials!

# ==================== Application ====================
NODE_ENV=production
APP_NAME=cognoscent-echo-backend
APP_VERSION=3.3.1

# ==================== Database (PostgreSQL) ====================
DB_HOST=postgres.db.internal  # Internal Docker service name
DB_PORT=5432
DB_NAME=interactive_novel_prod
DB_USER=prod_user
DB_PASSWORD=${PROD_DB_PASSWORD:-ChangeMeInProduction!}  # Set this from secrets manager/infrastructure
DB_SSLMODE=prefer             # Production: prefer SSL (use require for strict)

# ==================== Authentication & Security ====================
JWT_SECRET=${PROD_JWT_SECRET:-$(openssl rand -hex 64)}  # Generate with: openssl rand -hex 64
API_KEY=${PROD_API_KEY:-your_secure_api_key_here}       # Set this from secrets manager
SECURE_COOKIES=true
ADMIN_ROLE_REQUIRED=true      # Require admin token for sensitive routes

# ==================== Rate Limiting ====================
RATE_LIMIT_MAX=100            # Reasonable limit for production (adjust based on traffic)
RATE_LIMIT_TIME_WINDOW=5m     # 5 minute window

# ==================== CORS ====================
# Set to specific production origin (do not use * in production!)
ALLOWED_CORS_URLS=https://echo-platform.vercel.app,https://app.echo-platform.com
FRONTEND_URL=https://echo-platform.vercel.app

# ==================== Logging ====================
LOG_LEVEL=warn                # Production: reduce noise (info/warn for debugging)
ENABLE_JSON_LOGGING=true      # JSON structured logging for log aggregation
LOG_FORMAT=json

# ==================== Monitoring & Observability ====================
ENABLE_METRICS=true          # Enable Prometheus-style metrics endpoint
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30s
PROMETHEUS_JOB_NAME=cognoscent-echo-backend

# ==================== Feature Flags ====================
ENABLE_WASM_SANDBOX=false    # Disable sandbox in production (security tradeoff)
ENABLE_AI_RESPONSES=true     # AI responses enabled
ENABLE_GOVERNANCE_VOTING=true  # DAO voting enabled
ENABLE_ANALYTICS=true        # Usage analytics tracking

# ==================== Performance Tuning ====================
WORKER_PROCESSES=1           # Use single process for simplicity
MAX_PAYLOAD_SIZE=5mb         # Maximum request body size
TRUST_PROXY=true             # Trust X-Forwarded-For header behind reverse proxy

# ==================== Connection Pooling ====================
DB_POOL_MIN=2                # Minimum database connections
DB_POOL_MAX=10               # Maximum database connections
DB_IDLE_TIMEOUT=30s          # Connection idle timeout
DB_CONNECTION_TIMEOUT=5s     # New connection timeout

# ==================== Security Headers ====================
HSTS_ENABLED=true            # HTTP Strict Transport Security
HSTS_MAX_AGE=31536000        # 1 year HSTS max-age
CSP_REPORT_URI=https://csp-report.echo-platform.com/report    # CSP violation reporting
CSP_REPORT_ONLY=false         # Actually enforce CSP (not just report)

# ==================== Backups ====================
BACKUP_ENABLED=true          # Enable automated backups
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2:00 AM UTC
BACKUP_RETENTION_DAYS=7      # Keep backups for 7 days
BACKUP_PATH=/var/backups/postgresql

# ==================== Maintenance Mode ====================
MAINTENANCE_MODE=false       # Set to true during deployments
MAINTENANCE_MESSAGE="Site under maintenance. Please try again later."

# ==================== Alerting ====================
ENABLE_ALERTING=true         # Enable error alerting
ALERT_EMAIL=ops@echo-platform.com    # Email for critical alerts
SLACK_WEBHOOK_URL=""         # Slack webhook URL (set if using Slack)

# ==================== Secrets Management ====================
VAULT_ENABLED=false          # Set to true and configure if using HashiCorp Vault

# ==================== Graceful Shutdown ====================
GRACEFUL_SHUTDOWN_TIMEOUT=30s  # Time to wait for connections before shutdown
