# Cognoscent Echo - Application Configuration
# Copy this file to .env and fill in your values

# ==================== Application ====================
NODE_ENV=production
APP_NAME=cognoscent-echo
PORT=3001

# ==================== Database (PostgreSQL) ====================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=interactive_novel
DB_USER=postgres
DB_PASSWORD=postgres
ENABLE_JSON_LOGGING=true

# ==================== Authentication ====================
JWT_SECRET=saas_super_secret_key_99

# ==================== Rate Limiting ====================
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1m

# ==================== CORS ====================
ALLOWED_CORS_URLS=*

# ==================== Logging ====================
LOG_LEVEL=info

# ==================== Monitoring ====================
ENABLE_METRICS=false
METRICS_PORT=9090

# ==================== Frontend ====================
VITE_API_BASE=http://localhost:3001
