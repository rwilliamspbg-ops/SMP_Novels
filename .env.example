# Cognoscent Echo - Production Environment Configuration
# Copy this file to .env and fill in your values

# ==================== Application ====================
NODE_ENV=production
APP_NAME=cognoscent-echo

# ==================== Database (PostgreSQL) ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=interactive_novel
DB_USER=postgres
DB_PASSWORD=your_secure_database_password_here
ENABLE_JSON_LOGGING=true

# ==================== Authentication ====================
JWT_SECRET=cognoscent_production_jwt_secret_key_change_this_in_production_2024

# ==================== Rate Limiting ====================
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1m

# ==================== CORS ====================
ALLOWED_CORS_URLS=https://echo-platform.vercel.app,http://localhost:3000

# ==================== Backend API ====================
FRONTEND_URL=http://localhost:3000
BACKEND_PORT=3001

# ==================== Logging ====================
LOG_LEVEL=info

# ==================== Monitoring ====================
ENABLE_METRICS=true
METRICS_PORT=9090

# ==================== Health Checks ====================
HEALTH_CHECK_INTERVAL=30s
