# ========================================
# Cognoscent Echo - Production Environment
# Generate strong secrets before deploying
# ========================================

# ============ Authentication & Security ============
JWT_SECRET=<generate_strong_secret_here_64_hex_chars>
API_KEY=<your_api_key_for_authentication>
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ============ Database Connections ============
MONGODB_URI=mongodb://mongodb:27017/interactive_novel
DATABASE_URL=postgresql://novel_user:secure_password_here@postgres:5432/echo_db

# ============ Cache & Messaging ============
REDIS_URL=redis://redis:6379

# ============ Application Settings ============
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://yourdomain.com

# ============ Feature Flags ============
ENABLE_WASM_SANDBOX=false        # Disable WASM in production for security
ENABLE_AI_RESPONSES=true
ENABLE_GOVERNANCE_VOTING=true
ENABLE_ANALYTICS=true

# ============ Rate Limiting ============
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============ Logging ============
LOG_LEVEL=info
LOG_FORMAT=json

# ============ Monitoring & Observability ============
PROMETHEUS_ENABLED=false
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30000

# ============ Security Headers ============
CORS_ORIGIN=https://yourdomain.com
SECURE_COOKIES=true

# ============ Governance Defaults ============
BFT_THRESHOLD_PCT=55.5
DEFAULT_BLOCK_SIZE_BYTES=2000
d3fbf88fc1dc5ec668fef354c304118fc87c4e4bc51f066f4c6a5b6cd6ea656033a7a7e8c79ab2efe4b94721b7fca7ce169be44d0ab9a4b11ad99c9256c0e6ac
POSTGRES_PASSWORD=your_secure_password_here
