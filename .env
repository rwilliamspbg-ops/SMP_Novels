# Local development environment variables (placeholders).
# Replace values with secure secrets for production. DO NOT USE IN PRODUCTION.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=echo_db

# Use the docker-compose service hostnames for intra-compose networking
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/echo_db
REDIS_URL=redis://redis:6379
MONGODB_URI=mongodb://mongodb:27017/echo_db

# App secrets for local development
