# Cognoscent Echo - Local Development Environment
# Copy this file to .env and fill in your values

# ==================== Application ====================
NODE_ENV=development
APP_NAME=cognoscent-echo

# ==================== Database (PostgreSQL) ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=interactive_novel
DB_USER=postgres
DB_PASSWORD=dev_password_change_for_production
ENABLE_JSON_LOGGING=true

# ==================== Authentication ====================
JWT_SECRET=cognoscent_dev_jwt_key_change_this_in_production_2024

# ==================== Rate Limiting ====================
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1m

# ==================== CORS ====================
ALLOWED_CORS_URLS=http://localhost:3000,http://localhost:8080

# ==================== Backend API ====================
FRONTEND_URL=http://localhost:3000
BACKEND_PORT=3001

# ==================== Logging ====================
LOG_LEVEL=debug
