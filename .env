# ============ Authentication & Security ============
JWT_SECRET=<change_me_strong_secret_64_hex_chars>
API_KEY=<change_me_api_key_for_authentication>
STRIPE_SECRET_KEY=<your_stripe_test_mode_key>
STRIPE_PUBLISHABLE_KEY=<your_stripe_publishable_key>

# ============ Database Connections ============
MONGODB_URI=mongodb://mongodb:27017/interactive_novel
DATABASE_URL=postgresql://novel_user:secure_password@postgres:5432/echo_db

# ============ Cache & Messaging ============
REDIS_URL=redis://redis:6379

# ============ Application Settings ============
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ============ Feature Flags ============
ENABLE_WASM_SANDBOX=true
ENABLE_AI_RESPONSES=true
ENABLE_GOVERNANCE_VOTING=true
ENABLE_ANALYTICS=false

# ============ Rate Limiting ============
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============ Logging ============
LOG_LEVEL=debug
LOG_FORMAT=json

# ============ Monitoring & Observability ============
PROMETHEUS_ENABLED=false
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30000

# ============ Security Headers ============
CORS_ORIGIN=*
SECURE_COOKIES=true

# ============ Governance Defaults ============
BFT_THRESHOLD_PCT=55.5
DEFAULT_BLOCK_SIZE_BYTES=2000
