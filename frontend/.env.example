# Cognoscent Echo - Frontend Environment Configuration
# Copy this file to .env and fill in your values for production deployment

# ==================== Application ====================
NODE_ENV=production
APP_NAME=cognoscent-echo-frontend

# ==================== API Backend URL ====================
VITE_API_BASE=http://localhost:3001  # Change to production backend URL

# ==================== User Identification ====================
FRONTEND_USER_ID_GENERATOR=random  # Use UUID in production for persistent users

# ==================== Feature Flags ====================
ENABLE_WASM_SANDBOX=true
ENABLE_AI_RESPONSES=true
ENABLE_GOVERNANCE_VOTING=true
ENABLE_ANALYTICS=false

# ==================== Monitoring & Observability ====================
ENABLE_METRICS=false
METRICS_PORT=9090

# ==================== Glitch FX & Cinematics ====================
GLITCH_INTENSITY=medium
SOUNDSCAPE_ENABLED=true

# ==================== Debug Mode ====================
DEBUG_MODE=false
